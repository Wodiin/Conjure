        ],
        "traits": [
            {
                "name": "Arcane Ward",
                "description": "When the Abjurer casts an abjuration spell of 1st level or higher, they gain a ward with hit points equal to twice the spell's level plus their Intelligence modifier that absorbs damage in their place. The ward reforms whenever they cast another abjuration spell."
            }
        ],
        "bonus_actions": [],
        "reactions": [
            {
                "name": "Projected Ward",
                "description": "When a creature the Abjurer can see within 30 feet takes damage, they can use their reaction to have their Arcane Ward absorb that damage instead."
            }
